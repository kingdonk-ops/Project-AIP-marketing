---
import type { CollectionEntry } from 'astro:content';
import Specimen from './specimens/Specimen.astro';

// One modal per report; open it with any element carrying data-specimen="<report id>".
interface Props { report: CollectionEntry<'sample-reports'> }
const { report } = Astro.props;
---
<dialog
  id={`specimen-${report.id}`}
  aria-labelledby={`specimen-${report.id}-title`}
  class="w-[min(64rem,calc(100vw-2rem))] max-w-none rounded-2xl p-0 shadow-2xl backdrop:bg-black/60"
>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 px-5 py-3">
    <h2 id={`specimen-${report.id}-title`} class="text-sm font-semibold">{report.data.title}</h2>
    <div class="flex items-center gap-2">
      {report.data.downloadUrl && (
        <a href={report.data.downloadUrl} download class="rounded-full bg-brand-500 px-4 py-1.5 text-xs font-semibold text-white hover:bg-brand-600">Download PDF</a>
      )}
      <a href={`/sample-reports/${report.id}/`} class="rounded-full border border-gray-300 px-4 py-1.5 text-xs font-semibold hover:border-ink">Open full page</a>
      <button type="button" data-specimen-close class="rounded-full p-1.5 text-gray-500 hover:bg-gray-100 hover:text-ink" aria-label="Close preview">
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M5.3 5.3a1 1 0 011.4 0L10 8.6l3.3-3.3a1 1 0 111.4 1.4L11.4 10l3.3 3.3a1 1 0 01-1.4 1.4L10 11.4l-3.3 3.3a1 1 0 01-1.4-1.4L8.6 10 5.3 6.7a1 1 0 010-1.4z" /></svg>
      </button>
    </div>
  </div>
  <div class="max-h-[78vh] overflow-y-auto bg-sand p-3 sm:p-6">
    <Specimen kind={report.data.kind} />
  </div>
</dialog>

<script>
  document.querySelectorAll<HTMLElement>('[data-specimen]').forEach((trigger) => {
    const dialog = document.getElementById(`specimen-${trigger.dataset.specimen}`);
    if (!(dialog instanceof HTMLDialogElement)) return;
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      dialog.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog[id^="specimen-"]').forEach((dialog) => {
    dialog.querySelector('[data-specimen-close]')?.addEventListener('click', () => dialog.close());
    // A click on the backdrop lands on the dialog element itself.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
