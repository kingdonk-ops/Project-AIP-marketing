---
// Document chrome shared by every specimen report. All data shown is illustrative.
interface Props {
  title: string;
  docNo: string;
  meta: { label: string; value: string }[];
}
const { title, docNo, meta } = Astro.props;
---
<div class="specimen-sheet mx-auto w-full max-w-[820px] bg-white text-[11px] leading-snug text-gray-800 ring-1 ring-gray-200 print:ring-0">
  <div class="flex items-start justify-between gap-4 border-b-4 border-brand-500 px-6 pb-4 pt-6">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-md bg-brand-500 text-sm font-bold text-white">A</span>
      <div>
        <div class="text-sm font-semibold">project<span class="text-brand-600">aip</span></div>
        <div class="text-[10px] text-gray-500">Example Coatings Pty Ltd · contractor QA</div>
      </div>
    </div>
    <div class="text-right">
      <div class="font-mono text-[10px] text-gray-500">{docNo}</div>
      <div class="mt-1 rounded bg-amber-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-800">Specimen · illustrative data</div>
    </div>
  </div>
  <div class="px-6 pt-5">
    <h2 class="text-base font-semibold text-ink">{title}</h2>
    <dl class="mt-3 grid grid-cols-2 gap-x-6 gap-y-1.5 sm:grid-cols-4">
      {meta.map((m) => (
        <div>
          <dt class="text-[10px] uppercase tracking-wide text-gray-400">{m.label}</dt>
          <dd class="font-medium">{m.value}</dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="space-y-5 px-6 py-5">
    <slot />
  </div>
  <div class="flex flex-wrap justify-between gap-2 border-t border-gray-200 px-6 py-3 text-[10px] text-gray-400">
    <span>Generated by Project AIP from approved inspection records. Specimen for illustration only.</span>
    <span>Page 1 of 1</span>
  </div>
</div>
