---
import { cta } from '../lib/site';

const nav = [
  { label: 'Features', href: '/features/' },
  { label: 'Industries', href: '/industries/' },
  { label: 'Sample reports', href: '/sample-reports/' },
  { label: 'Security', href: '/security-and-data/' },
  { label: 'Pricing', href: '/pricing/' }
];
---
<header class="sticky top-0 z-50 border-b border-gray-100 bg-white/95 backdrop-blur print:hidden">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6">
    <a href="/" class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500 text-base font-bold text-white">A</span>
      <span class="text-lg font-semibold tracking-tight">project<span class="text-brand-600">aip</span></span>
    </a>
    <nav class="hidden items-center gap-7 text-sm font-medium text-gray-700 lg:flex" aria-label="Main">
      {nav.map((item) => <a href={item.href} class="hover:text-ink">{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <a href={cta.demo.href} class="whitespace-nowrap rounded-full bg-ink px-4 py-2 text-sm font-semibold text-white transition hover:bg-gray-800 sm:px-5">{cta.demo.short}</a>
      <details class="relative lg:hidden">
        <summary class="flex cursor-pointer list-none items-center rounded-full p-2 text-gray-700 hover:bg-gray-100 [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd" /></svg>
        </summary>
        <nav class="absolute right-0 mt-2 w-56 rounded-2xl border border-gray-200 bg-white p-2 shadow-lg" aria-label="Mobile">
          {nav.map((item) => <a href={item.href} class="block rounded-xl px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-sand hover:text-ink">{item.label}</a>)}
          <a href="/modules/" class="block rounded-xl px-4 py-2.5 text-sm font-medium text-gray-700 hover:bg-sand hover:text-ink">All modules</a>
        </nav>
      </details>
    </div>
  </div>
</header>
