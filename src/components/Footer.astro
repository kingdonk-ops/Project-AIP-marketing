---
import StatusPill from './StatusPill.astro';
---
<footer class="bg-ink py-14 text-sm text-gray-400 print:hidden">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-6 md:grid-cols-6">
    <div>
      <h2 class="mb-4 font-semibold text-white"><a href="/products/" class="hover:text-white">Products</a></h2>
      <ul class="space-y-2.5">
        <li><a href="/products/" class="hover:text-white">Overview</a></li>
        <li><a href="/features/offline-field-app/" class="hover:text-white">SiteSync — Tablet app</a></li>
        <li><a href="/products/#project-aip" class="hover:text-white">Project AIP — Web app</a></li>
      </ul>
    </div>
    <div>
      <h2 class="mb-4 font-semibold text-white">Features</h2>
      <ul class="space-y-2.5">
        <li><a href="/features/itp-management/" class="hover:text-white">ITP management</a></li>
        <li><a href="/features/field-reporting/" class="hover:text-white">Field reporting</a></li>
        <li><a href="/features/hardware-sync/" class="hover:text-white">Hardware & gauge sync</a></li>
        <li><a href="/features/task-management/" class="hover:text-white">Task management</a></li>
        <li><a href="/modules/" class="hover:text-white">All modules</a></li>
      </ul>
    </div>
    <div>
      <h2 class="mb-4 font-semibold text-white">Industries</h2>
      <ul class="space-y-2.5">
        <li><a href="/industries/oil-and-gas/" class="hover:text-white">Oil, gas & LNG</a></li>
        <li><a href="/industries/mining-and-resources/" class="hover:text-white">Mining & resources</a></li>
        <li><a href="/industries/protective-coatings-ndt/" class="hover:text-white">Protective coatings & NDT</a></li>
        <li><a href="/industries/structural-welding/" class="hover:text-white">Structural welding</a></li>
      </ul>
    </div>
    <div>
      <h2 class="mb-4 font-semibold text-white">Evaluate</h2>
      <ul class="space-y-2.5">
        <li><a href="/sample-reports/" class="hover:text-white">Sample reports</a></li>
        <li><a href="/security-and-data/" class="hover:text-white">Security & data</a></li>
        <li><a href="/pricing/" class="hover:text-white">Pricing</a></li>
        <li><a href="/contact/" class="hover:text-white">Book a demo</a></li>
      </ul>
    </div>
    <div>
      <h2 class="mb-4 font-semibold text-white">Information</h2>
      <ul class="space-y-2.5">
        <li><a href="/legal/msa/" class="hover:text-white">Service agreement (draft)</a></li>
        <li><a href="/legal/sla/" class="hover:text-white">Service level agreement (draft)</a></li>
        <li><a href="/legal/privacy-policy/" class="hover:text-white">Privacy policy (draft)</a></li>
        <li><a href="/status/" class="hover:text-white">System status</a></li>
      </ul>
    </div>
    <div class="col-span-2 md:col-span-1">
      <h2 class="mb-4 font-semibold text-white">Project AIP</h2>
      <p>Field-first ITP execution and QA/QC records for heavy industry.</p>
      <p class="mt-2 text-xs text-gray-500">Hosting, security and compliance claims should be confirmed for each deployment.</p>
    </div>
  </div>
  <div class="mx-auto mt-10 flex max-w-6xl flex-wrap items-center justify-between gap-4 border-t border-gray-800 px-6 pt-6">
    <span class="text-xs text-gray-500">© {new Date().getFullYear()} Project AIP</span>
    <StatusPill />
  </div>
</footer>
