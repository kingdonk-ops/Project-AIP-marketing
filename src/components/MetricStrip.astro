---
interface Props { metrics: { value: string; label: string }[] }
const { metrics } = Astro.props;
---
<section class="bg-sand py-12">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-6 text-center md:grid-cols-4">
    {metrics.map((metric) => (
      <div>
        <div class="text-3xl font-semibold tracking-tight">{metric.value}</div>
        <div class="mt-1 text-sm text-gray-600">{metric.label}</div>
      </div>
    ))}
  </div>
</section>
