---
interface Props { metrics: { value: string; label: string }[] }
const { metrics } = Astro.props;
---
<section class="border-y border-slate-800/80 bg-[#080b11] py-8">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-6 px-6 text-center md:grid-cols-4">
    {metrics.map((metric) => <div><div class="text-3xl font-extrabold text-white">{metric.value}</div><div class="mt-1 text-xs uppercase tracking-wider text-slate-400">{metric.label}</div></div>)}
  </div>
</section>