---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricStrip from '../components/MetricStrip.astro';
import { getCollection } from 'astro:content';

const modules = (await getCollection('modules')).sort((a, b) => a.data.order - b.data.order);
const industries = await getCollection('industries');
const whitepapers = await getCollection('whitepapers');

const metrics = [
  { value: 'Offline-first', label: 'Field capture' },
  { value: 'Provisional', label: 'Until reconciled' },
  { value: 'Audited', label: 'Recovery actions' },
  { value: 'AU', label: 'Standards focus' }
];
---

<BaseLayout title="Project AIP | Industrial QA/QC Inspection Management">
  <section class="relative overflow-hidden border-b border-slate-800/80 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-blue-950/30 via-[#0b0f17] to-[#0b0f17] pb-20 pt-24">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <div class="mb-8 inline-flex items-center gap-2 rounded-full border border-blue-500/30 bg-blue-500/10 px-3.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-400">
        Asset Inspection Platform
      </div>
      <h1 class="mx-auto max-w-4xl text-4xl font-extrabold leading-tight tracking-tight text-white sm:text-6xl">
        QA/QC Inspection Management for Heavy Industry
      </h1>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-slate-400">
        Designed for industrial coating, structural welding and plant maintenance teams who need inspection records that keep working when the site network does not.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href="/pricing" class="rounded bg-blue-600 px-8 py-3.5 text-sm font-semibold uppercase tracking-wide text-white shadow-xl shadow-blue-600/20 transition hover:bg-blue-500">
          Commercial Options
        </a>
        <a href="#modules" class="rounded border border-slate-700 px-8 py-3.5 text-sm font-semibold uppercase tracking-wide text-slate-200 transition hover:bg-slate-800">
          View Modules
        </a>
      </div>
    </div>
  </section>

  <MetricStrip metrics={metrics} />

  <section id="modules" class="mx-auto max-w-6xl px-6 py-24">
    <div class="mb-12">
      <span class="text-xs font-semibold uppercase tracking-wider text-blue-500">Platform</span>
      <h2 class="mt-1 text-3xl font-bold tracking-tight text-white">Modules & Features</h2>
    </div>
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      {modules.map((m) => (
        <a href={`/modules/${m.slug}`} class="group block rounded-xl border border-slate-800/90 bg-[#0f1420] p-8 transition hover:border-blue-500/50">
          <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-blue-400">{m.data.category}</div>
          <h3 class="text-xl font-bold text-white transition group-hover:text-blue-400">{m.data.title}</h3>
          <p class="mt-2 text-sm text-slate-400">{m.data.tagline}</p>
          <ul class="mt-6 space-y-2">
            {m.data.specs.map((spec) => (
              <li class="flex items-center gap-2 text-xs text-slate-300">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>
                {spec}
              </li>
            ))}
          </ul>
        </a>
      ))}
    </div>
  </section>

  <section id="industries" class="border-t border-slate-800/80 bg-[#080b11] py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-12">
        <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Field Disciplines</span>
        <h2 class="mt-1 text-3xl font-bold tracking-tight text-white">Built Around Inspection Plans</h2>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {industries.map((ind) => (
          <a href={`/industries/${ind.slug}`} class="block rounded-xl border border-slate-800 bg-[#0d121c] p-8 transition hover:border-slate-700">
            <div class="mb-4 inline-block rounded bg-slate-800 px-2.5 py-1 font-mono text-[11px] text-slate-300">{ind.data.standardCode}</div>
            <h3 class="mb-2 text-xl font-bold text-white">{ind.data.title}</h3>
            <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">Inspection types</div>
            <div class="flex flex-wrap gap-1.5">
              {ind.data.inspectionTypes.map((type) => (
                <span class="rounded border border-slate-800 bg-slate-900 px-2 py-0.5 text-[11px] text-slate-300">{type}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {whitepapers.length > 0 && (
    <section id="resources" class="mx-auto max-w-6xl px-6 py-24">
      <div class="mb-12">
        <span class="text-xs font-semibold uppercase tracking-wider text-blue-500">Resources</span>
        <h2 class="mt-1 text-3xl font-bold tracking-tight text-white">Technical Papers</h2>
      </div>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {whitepapers.map((wp) => (
          <a href={`/whitepaper/${wp.slug}`} class="block rounded-xl border border-slate-800 bg-[#0f1420] p-8 transition hover:border-blue-500/50">
            <h3 class="text-lg font-bold text-white">{wp.data.title}</h3>
            <p class="mt-2 text-sm text-slate-400">{wp.data.abstract}</p>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
