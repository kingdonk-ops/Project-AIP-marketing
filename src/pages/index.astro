---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetricStrip from '../components/MetricStrip.astro';
import { getCollection } from 'astro:content';

const allModules = await getCollection('modules');
const modules = allModules.filter((m) => m.data.featured).sort((a, b) => a.data.order - b.data.order);
const industries = await getCollection('industries');
const whitepapers = await getCollection('whitepapers');

const metrics = [
  { value: 'Offline-first', label: 'Field capture' },
  { value: 'Provisional', label: 'Until reconciled' },
  { value: 'Audited', label: 'Recovery actions' },
  { value: 'AU', label: 'Standards focus' }
];

// Illustrative values for the product preview only.
const previewTiles = [
  { label: 'Open ITPs', value: '24' },
  { label: 'Hold points pending', value: '7' },
  { label: 'Provisional (offline)', value: '3' },
  { label: 'Closed this week', value: '112' }
];
const previewRows = [
  { id: 'ITP-COAT-01', item: 'Tank T-104 shell coating', stage: 'DFT verification', state: 'Hold point' },
  { id: 'ITP-WELD-01', item: 'Pipe rack PR-3 welds', stage: 'Visual inspection', state: 'In progress' },
  { id: 'ITP-COAT-01', item: 'Spool SP-221 blast', stage: 'Surface profile', state: 'Provisional' }
];
const stateClass = {
  'Hold point': 'bg-amber-50 text-amber-700',
  'In progress': 'bg-blue-50 text-blue-700',
  Provisional: 'bg-brand-50 text-brand-700'
};
---

<BaseLayout title="Project AIP | Industrial QA/QC Inspection Management">
  <section class="pb-16 pt-20 sm:pt-28">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-6xl">
        QA/QC inspection management for heavy industry
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-600">
        One system for inspection test plans, hold points and field records — built for coating, welding and plant maintenance teams who work where the network doesn't.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/pricing/#contact" class="rounded-full bg-brand-500 px-7 py-3.5 text-base font-semibold text-white transition hover:bg-brand-600">Discuss a pilot</a>
        <a href="#modules" class="rounded-full bg-ink px-7 py-3.5 text-base font-semibold text-white transition hover:bg-gray-800">See the platform</a>
      </div>
    </div>

    <!-- Illustrative product preview -->
    <div class="mx-auto mt-16 max-w-5xl px-6">
      <div class="rounded-2xl border border-gray-200 bg-white p-4 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.15)] sm:p-6">
        <div class="mb-5 flex items-center justify-between">
          <span class="text-sm font-semibold">project<span class="text-brand-600">aip</span> <span class="font-normal text-gray-400">· Dashboard</span></span>
          <span class="text-xs text-gray-400">Illustrative</span>
        </div>
        <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
          {previewTiles.map((t) => (
            <div class="rounded-xl border border-gray-200 border-l-4 border-l-brand-500 p-4 text-left">
              <div class="text-xs text-gray-500">{t.label}</div>
              <div class="mt-1 text-2xl font-semibold">{t.value}</div>
            </div>
          ))}
        </div>
        <div class="mt-4 overflow-x-auto rounded-xl border border-gray-200">
          <table class="w-full min-w-[520px] text-left text-sm">
            <thead class="bg-sand text-xs text-gray-500">
              <tr><th class="px-4 py-2.5 font-medium">ITP</th><th class="px-4 py-2.5 font-medium">Item</th><th class="px-4 py-2.5 font-medium">Stage</th><th class="px-4 py-2.5 font-medium">Status</th></tr>
            </thead>
            <tbody>
              {previewRows.map((r) => (
                <tr class="border-t border-gray-100">
                  <td class="px-4 py-3 font-mono text-xs text-gray-500">{r.id}</td>
                  <td class="px-4 py-3">{r.item}</td>
                  <td class="px-4 py-3 text-gray-600">{r.stage}</td>
                  <td class="px-4 py-3"><span class={`rounded-full px-2.5 py-1 text-xs font-medium ${stateClass[r.state]}`}>{r.state}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <MetricStrip metrics={metrics} />

  <section id="modules" class="mx-auto max-w-6xl scroll-mt-20 px-6 py-24">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <span class="text-sm font-semibold text-brand-600">Platform</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Built for the realities of field inspection</h2>
      </div>
      <a href="/modules/" class="rounded-full border border-gray-300 px-5 py-2.5 text-sm font-semibold transition hover:border-ink">All {allModules.length} modules →</a>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {modules.map((m) => (
        <a href={`/modules/${m.slug}/`} class="group flex flex-col rounded-2xl border border-gray-200 p-7 transition hover:border-brand-500 hover:shadow-lg">
          <div class="text-xs font-semibold uppercase tracking-wide text-brand-600">{m.data.category}</div>
          <h3 class="mt-3 text-lg font-semibold leading-snug">{m.data.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">{m.data.tagline}</p>
          <ul class="mt-5 space-y-2">
            {m.data.specs.slice(0, 4).map((spec) => (
              <li class="flex items-start gap-2 text-sm text-gray-700">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
                {spec}
              </li>
            ))}
          </ul>
          <span class="mt-auto pt-6 text-sm font-semibold text-ink group-hover:text-brand-600">Learn more →</span>
        </a>
      ))}
    </div>
  </section>

  <section id="industries" class="scroll-mt-20 bg-sand py-24">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-12 max-w-2xl">
        <span class="text-sm font-semibold text-brand-600">Industries</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Built around your inspection plans</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {industries.map((ind) => (
          <a href={`/industries/${ind.slug}/`} class="block rounded-2xl bg-white p-8 transition hover:shadow-lg">
            <div class="mb-4 inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">{ind.data.standardCode}</div>
            <h3 class="mb-4 text-xl font-semibold">{ind.data.title}</h3>
            <div class="flex flex-wrap gap-2">
              {ind.data.inspectionTypes.map((type) => (
                <span class="rounded-full border border-gray-200 px-3 py-1 text-xs text-gray-700">{type}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {whitepapers.length > 0 && (
    <section id="resources" class="mx-auto max-w-6xl px-6 py-24">
      <div class="mb-12 max-w-2xl">
        <span class="text-sm font-semibold text-brand-600">Resources</span>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">Technical papers</h2>
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {whitepapers.map((wp) => (
          <a href={`/whitepaper/${wp.slug}/`} class="block rounded-2xl border border-gray-200 p-8 transition hover:border-brand-500 hover:shadow-lg">
            <h3 class="text-lg font-semibold">{wp.data.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">{wp.data.abstract}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="px-6 pb-24">
    <div class="mx-auto max-w-6xl rounded-3xl bg-ink px-8 py-16 text-center text-white">
      <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Ready to run a pilot?</h2>
      <p class="mx-auto mt-4 max-w-xl text-gray-400">Start with one project and your own ITPs, and see how offline field capture fits your QA process.</p>
      <a href="/pricing/#contact" class="mt-8 inline-block rounded-full bg-brand-500 px-7 py-3.5 font-semibold text-white transition hover:bg-brand-600">Discuss a pilot</a>
    </div>
  </section>
</BaseLayout>
