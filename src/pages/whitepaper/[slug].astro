---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('whitepapers');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={`${entry.data.title} | Project AIP`} description={entry.data.abstract}>
  <article class="mx-auto max-w-3xl px-6 py-20">
    <a href="/#resources" class="text-sm font-medium text-gray-500 hover:text-ink">← Resources</a>
    <div class="mt-6 border-b border-gray-200 pb-10">
      <div class="text-xs font-semibold uppercase tracking-wide text-brand-600">Technical paper · {entry.data.releaseDate}</div>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight">{entry.data.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-gray-600">{entry.data.abstract}</p>
    </div>
    {entry.data.leadGateRequired ? (
      <div class="mt-10 rounded-2xl bg-sand p-7 text-gray-700">
        This paper is available on request. <a href="/pricing/#contact" class="font-semibold text-brand-700 hover:underline">Get in touch</a> to receive a copy.
      </div>
    ) : (
      <div class="prose prose-gray mt-10 max-w-none prose-headings:font-semibold prose-a:text-brand-700">
        <Content />
      </div>
    )}
  </article>
</BaseLayout>
