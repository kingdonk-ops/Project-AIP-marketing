---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('whitepapers');
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BaseLayout title={`${entry.data.title} | Project AIP`} description={entry.data.abstract}>
  <article class="mx-auto max-w-3xl px-6 py-20">
    <div class="mb-8 border-b border-slate-800 pb-8">
      <div class="mb-2 text-xs font-semibold uppercase tracking-wider text-blue-500">Technical paper · {entry.data.releaseDate}</div>
      <h1 class="text-3xl font-extrabold text-white sm:text-4xl">{entry.data.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-slate-400">{entry.data.abstract}</p>
    </div>
    {entry.data.leadGateRequired ? (
      <div class="rounded-lg border border-slate-800 bg-[#0f1420] p-6 text-sm text-slate-300">
        This paper is available on request. <a href="/pricing#contact" class="text-blue-400 hover:underline">Get in touch</a> to receive a copy.
      </div>
    ) : (
      <div class="prose prose-invert max-w-none prose-a:text-blue-400">
        <Content />
      </div>
    )}
  </article>
</BaseLayout>
