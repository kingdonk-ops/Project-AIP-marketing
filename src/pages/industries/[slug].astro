---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import MetricStrip from '../../components/MetricStrip.astro';
import SpecimenDialog from '../../components/SpecimenDialog.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import { cta } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('industries');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const report = entry.data.sampleReport ? await getEntry('sample-reports', entry.data.sampleReport) : undefined;
const related = (await Promise.all(entry.data.relatedModules.map((id) => getEntry('modules', id)))).filter((m) => m !== undefined);
---

<BaseLayout title={`${entry.data.title} | Project AIP`} description={entry.data.tagline}>
  <section class="mx-auto max-w-4xl px-6 pb-16 pt-20">
    <a href="/industries/" class="block text-sm font-medium text-gray-500 hover:text-ink">← Industries</a>
    <div class="mt-6 inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">{entry.data.standardCode}</div>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{entry.data.title}</h1>
    {entry.data.tagline && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-gray-600">{entry.data.tagline}</p>}
    <p class="mt-5 text-sm text-gray-500">Sample plan: <span class="font-medium text-gray-700">{entry.data.itpSampleTitle}</span></p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={cta.demo.href} class="rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-600">{cta.demo.label}</a>
      {report && (
        <a href={`/sample-reports/${report.id}/`} data-specimen={report.id} class="rounded-full bg-ink px-6 py-3 text-sm font-semibold text-white transition hover:bg-gray-800">Sample: {report.data.title}</a>
      )}
    </div>
  </section>

  {entry.data.heroMetrics.length > 0 && <MetricStrip metrics={entry.data.heroMetrics} />}

  <section class="mx-auto max-w-6xl px-6 py-20">
    {entry.data.workflows.length > 0 && (
      <div class="mb-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {entry.data.workflows.map((w) => (
          <div class="rounded-2xl border border-gray-200 p-6">
            <h2 class="font-semibold">{w.title}</h2>
            <p class="mt-2 text-sm leading-relaxed text-gray-600">{w.text}</p>
          </div>
        ))}
      </div>
    )}

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      <div class="rounded-2xl border border-gray-200 p-6">
        <h2 class="mb-4 text-sm font-semibold">Key risks</h2>
        <ul class="space-y-2.5 text-sm text-gray-700">
          {entry.data.keyRisks.map((r) => (
            <li class="flex items-start gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500"></span>{r}</li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl bg-sand p-6">
        <h2 class="mb-4 text-sm font-semibold">Inspection types</h2>
        <ul class="space-y-2.5 text-sm text-gray-700">
          {entry.data.inspectionTypes.map((t) => (
            <li class="flex items-start gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>{t}</li>
          ))}
        </ul>
      </div>
    </div>

    <div class="prose prose-gray mx-auto mt-16 max-w-3xl prose-headings:font-semibold prose-a:text-brand-700">
      <Content />
    </div>
  </section>

  {related.length > 0 && (
    <section class="bg-sand py-20">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="text-2xl font-semibold tracking-tight">Modules used in {entry.data.title.toLowerCase()}</h2>
        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((m) => (
            <a href={`/modules/${m.id}/`} class="flex flex-col rounded-2xl bg-white p-6 transition hover:shadow-lg">
              <div class="flex items-start justify-between gap-3">
                <h3 class="font-semibold">{m.data.title}</h3>
                <StatusBadge status={m.data.status} />
              </div>
              <p class="mt-2 text-sm leading-relaxed text-gray-600">{m.data.tagline}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="pt-24"><CtaBand /></div>
  {report && <SpecimenDialog report={report} />}
</BaseLayout>
