---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { statusLabel, statusClass } from '../../lib/modules';

export async function getStaticPaths() {
  const entries = await getCollection('modules');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Project AIP`} description={entry.data.tagline}>
  <article class="mx-auto max-w-3xl px-6 py-20">
    <a href="/modules/" class="text-sm font-medium text-gray-500 hover:text-ink">← All modules</a>
    <div class="mt-6 border-b border-gray-200 pb-10">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-xs font-semibold uppercase tracking-wide text-brand-600">{entry.data.category}</span>
        <span class={`rounded-full px-2.5 py-0.5 text-xs font-medium ${statusClass[entry.data.status]}`}>{statusLabel[entry.data.status]}</span>
      </div>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{entry.data.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-gray-600">{entry.data.tagline}</p>
    </div>

    <div class="my-10 rounded-2xl bg-sand p-7">
      <h2 class="mb-4 text-sm font-semibold">Capabilities</h2>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {entry.data.specs.map((s) => (
          <li class="flex items-start gap-2 text-sm text-gray-700">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
            {s}
          </li>
        ))}
      </ul>
      {entry.data.safetyCompliance && (
        <p class="mt-6 border-t border-gray-200 pt-4 text-sm text-gray-600">{entry.data.safetyCompliance}</p>
      )}
    </div>

    <div class="prose prose-gray max-w-none prose-headings:font-semibold prose-a:text-brand-700">
      <Content />
    </div>

    {entry.data.industryUse.length > 0 && (
      <section class="mt-14">
        <h2 class="text-2xl font-semibold tracking-tight">How it helps across industries</h2>
        <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
          {entry.data.industryUse.map((u) => (
            <div class="rounded-2xl border border-gray-200 p-5">
              <div class="inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-medium text-brand-700">{u.industry}</div>
              <p class="mt-3 text-sm leading-relaxed text-gray-700">{u.text}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="mt-14 rounded-2xl bg-ink px-7 py-8 text-white sm:flex sm:items-center sm:justify-between sm:gap-6">
      <div>
        <h2 class="text-lg font-semibold">See {entry.data.title} in a pilot</h2>
        <p class="mt-1 text-sm text-gray-400">Start with one project and your own inspection plans.</p>
      </div>
      <a href="/contact/" class="mt-5 inline-block whitespace-nowrap rounded-full bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600 sm:mt-0">Book a demo</a>
    </div>
  </article>
</BaseLayout>
