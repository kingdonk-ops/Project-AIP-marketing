---
import BaseLayout from '../layouts/BaseLayout.astro';

const tiers = [
  {
    name: 'Pilot',
    summary: 'A time-boxed trial on a single project or work front.',
    features: ['One project workspace', 'Configured sample ITPs', 'Offline field capture', 'Onboarding support']
  },
  {
    name: 'Project',
    summary: 'For a live project or maintenance campaign.',
    features: ['Multiple work packs and disciplines', 'Role-based access control', 'Administrative recovery tools', 'Reporting and record export'],
    highlight: true
  },
  {
    name: 'Enterprise',
    summary: 'For organisations standardising inspection across sites.',
    features: ['Multi-project governance', 'Custom ITP libraries', 'Integration options', 'Agreed service levels']
  }
];
---

<BaseLayout title="Commercial Options | Project AIP">
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mb-12 text-center">
      <span class="text-xs font-semibold uppercase tracking-wider text-blue-500">Commercial</span>
      <h1 class="mt-1 text-3xl font-extrabold text-white sm:text-5xl">Commercial Options</h1>
      <p class="mx-auto mt-4 max-w-2xl text-slate-400">Pricing is quoted in AUD and depends on project scope, user count and deployment requirements.</p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {tiers.map((tier) => (
        <div class={`flex flex-col rounded-xl border p-8 ${tier.highlight ? 'border-blue-500/60 bg-[#0f1420]' : 'border-slate-800 bg-[#0d121c]'}`}>
          <h2 class="text-xl font-bold text-white">{tier.name}</h2>
          <p class="mt-2 text-sm text-slate-400">{tier.summary}</p>
          <div class="mt-6 text-2xl font-extrabold text-white">On request</div>
          <ul class="mt-6 flex-1 space-y-2">
            {tier.features.map((f) => (
              <li class="flex items-center gap-2 text-xs text-slate-300">
                <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500"></span>
                {f}
              </li>
            ))}
          </ul>
          <a href="#contact" class="mt-8 block rounded bg-blue-600 px-4 py-2.5 text-center text-xs font-semibold uppercase tracking-wide text-white hover:bg-blue-500">Discuss {tier.name}</a>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="border-t border-slate-800/80 bg-[#080b11] py-20">
    <div class="mx-auto max-w-3xl px-6 text-center">
      <h2 class="text-2xl font-bold text-white">Discuss a pilot</h2>
      <p class="mt-4 text-slate-400">Enquiry form coming soon. Contact details will be published here before launch.</p>
    </div>
  </section>
</BaseLayout>
