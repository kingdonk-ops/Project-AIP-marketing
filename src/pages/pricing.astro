---
import BaseLayout from '../layouts/BaseLayout.astro';

const tiers = [
  {
    name: 'Pilot',
    summary: 'A time-boxed trial on a single project or work front.',
    features: ['One project workspace', 'Configured sample ITPs', 'Offline field capture', 'Onboarding support']
  },
  {
    name: 'Project',
    summary: 'For a live project or maintenance campaign.',
    features: ['Multiple work packs and disciplines', 'Role-based access control', 'Administrative recovery tools', 'Reporting and record export'],
    highlight: true
  },
  {
    name: 'Enterprise',
    summary: 'For organisations standardising inspection across sites.',
    features: ['Multi-project governance', 'Custom ITP libraries', 'Integration options', 'Agreed service levels']
  }
];
---

<BaseLayout title="Commercial Options | Project AIP">
  <section class="mx-auto max-w-6xl px-6 py-20">
    <div class="mx-auto mb-14 max-w-2xl text-center">
      <span class="text-sm font-semibold text-brand-600">Pricing</span>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">Commercial options</h1>
      <p class="mt-4 text-lg text-gray-600">Pricing is quoted in AUD and depends on project scope, user count and deployment requirements.</p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      {tiers.map((tier) => (
        <div class={`relative flex flex-col rounded-2xl p-8 ${tier.highlight ? 'border-2 border-brand-500 shadow-lg' : 'border border-gray-200'}`}>
          {tier.highlight && <span class="absolute -top-3 left-8 rounded-full bg-brand-500 px-3 py-1 text-xs font-semibold text-white">Most common</span>}
          <h2 class="text-xl font-semibold">{tier.name}</h2>
          <p class="mt-2 text-sm text-gray-600">{tier.summary}</p>
          <div class="mt-6 text-3xl font-semibold tracking-tight">On request</div>
          <ul class="mt-6 flex-1 space-y-2.5">
            {tier.features.map((f) => (
              <li class="flex items-start gap-2 text-sm text-gray-700">
                <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 111.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z" clip-rule="evenodd" /></svg>
                {f}
              </li>
            ))}
          </ul>
          <a href="#contact" class={`mt-8 block rounded-full px-5 py-3 text-center text-sm font-semibold text-white transition ${tier.highlight ? 'bg-brand-500 hover:bg-brand-600' : 'bg-ink hover:bg-gray-800'}`}>Discuss {tier.name}</a>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="scroll-mt-20 bg-sand py-20">
    <div class="mx-auto max-w-2xl px-6 text-center">
      <h2 class="text-3xl font-semibold tracking-tight">Discuss a pilot</h2>
      <p class="mt-4 text-gray-600">Enquiry form coming soon. Contact details will be published here before launch.</p>
    </div>
  </section>
</BaseLayout>
