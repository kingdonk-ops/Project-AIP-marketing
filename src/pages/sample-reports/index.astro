---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Check from '../../components/Check.astro';
import CtaBand from '../../components/CtaBand.astro';
import SpecimenDialog from '../../components/SpecimenDialog.astro';

const reports = (await getCollection('sample-reports')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Sample Reports | Project AIP" description="Specimen coating daily reports, NCRs and ITP sign-off logs generated by Project AIP.">
  <section class="mx-auto max-w-6xl px-6 pb-20 pt-20">
    <div class="max-w-2xl">
      <span class="text-sm font-semibold text-brand-600">Sample reports</span>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">See exactly what your client receives</h1>
      <p class="mt-4 text-lg text-gray-600">Specimen deliverables built from inspection records. Preview them here, open the full page, or print them to PDF. All names, projects and values are illustrative.</p>
    </div>
    <div class="mt-12 space-y-6">
      {reports.map((r) => (
        <div class="grid grid-cols-1 gap-8 rounded-2xl border border-gray-200 p-8 lg:grid-cols-[1.2fr_1fr]">
          <div class="flex flex-col">
            <h2 class="text-2xl font-semibold tracking-tight">{r.data.title}</h2>
            <p class="mt-3 leading-relaxed text-gray-600">{r.data.summary}</p>
            <p class="mt-4 text-sm text-gray-500">For: <span class="text-gray-700">{r.data.audience}</span></p>
            <div class="mt-auto flex flex-wrap gap-3 pt-6">
              <a href={`/sample-reports/${r.id}/`} data-specimen={r.id} class="rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-800">Preview</a>
              {r.data.downloadUrl
                ? <a href={r.data.downloadUrl} download class="rounded-full bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">Download PDF</a>
                : <a href={`/sample-reports/${r.id}/`} class="rounded-full border border-gray-300 px-5 py-2.5 text-sm font-semibold transition hover:border-ink">Open & print to PDF</a>}
            </div>
          </div>
          <ul class="space-y-3 rounded-xl bg-sand p-6">
            {r.data.includes.map((item) => <li class="flex items-start gap-2 text-sm text-gray-700"><Check />{item}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <CtaBand title="Want it in your format?" text="Report templates follow your client's layout, logo and document numbering. Book a demo and bring a report you produce today." />
  {reports.map((r) => <SpecimenDialog report={r} />)}
</BaseLayout>
