---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';
import Specimen from '../../components/specimens/Specimen.astro';
import { cta } from '../../lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('sample-reports');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
---

<BaseLayout title={`${entry.data.title} (sample) | Project AIP`} description={entry.data.summary}>
  <section class="mx-auto max-w-4xl px-6 pb-8 pt-16 print:hidden">
    <a href="/sample-reports/" class="text-sm font-medium text-gray-500 hover:text-ink">← Sample reports</a>
    <h1 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{entry.data.title}</h1>
    <p class="mt-3 max-w-2xl text-gray-600">{entry.data.summary}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      {entry.data.downloadUrl && (
        <a href={entry.data.downloadUrl} download class="rounded-full bg-brand-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-600">Download PDF</a>
      )}
      <button type="button" data-print class="rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-gray-800">Print or save as PDF</button>
      <a href={cta.demo.href} class="rounded-full border border-gray-300 px-5 py-2.5 text-sm font-semibold transition hover:border-ink">{cta.demo.label}</a>
    </div>
  </section>
  <section class="bg-sand px-3 py-10 sm:px-6 print:bg-white print:p-0">
    <Specimen kind={entry.data.kind} />
  </section>
  <div class="pt-20 print:hidden"><CtaBand /></div>
</BaseLayout>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>
